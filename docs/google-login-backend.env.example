# Gửi BE (hanni-server) — để app Hanni đăng nhập Google được.
#
# App gọi đúng API của web: POST /api/auth/google  { "idToken": "<id token Google>" }  → trả { isNewUser } + cookie phiên.
# Khác web duy nhất ở chỗ: idToken của app do OAuth client RIÊNG của app cấp, nên trường `aud` của token là client ID
# của app chứ không phải GOOGLE_CLIENT_ID của web. Server cần chấp nhận thêm các client ID này khi verify, vd:
#   verifyIdToken({ idToken, audience: [GOOGLE_CLIENT_ID, ...GOOGLE_MOBILE_CLIENT_IDS] })
# (tên biến dưới đây là đề xuất — đặt tên khác cũng được, miễn verify nhận đủ các client ID).

# Đang có — client ID của web (trùng NEXT_PUBLIC_GOOGLE_CLIENT_ID của hanni-client). Giữ nguyên.
GOOGLE_CLIENT_ID=xxxxxxxx-web.apps.googleusercontent.com

# MỚI — client ID của app, cách nhau dấu phẩy:
#   - client "Web application" của app (= EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID bên app; idToken trên Android mang aud này)
#   - client "iOS" của app (= EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID; idToken trên iPhone mang aud này) — thêm khi có bản iOS
GOOGLE_MOBILE_CLIENT_IDS=977963570920-mtgqrosdib14ulgd185mkbcgk7gi4cpf.apps.googleusercontent.com
